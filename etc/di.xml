<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Kingletas\ProcessGuard\Api\ProcessGuardInterface"
                type="Kingletas\ProcessGuard\Model\Guard\ProcessGuard"/>
    <preference for="Kingletas\ProcessGuard\Api\ObserverPolicyResolverInterface"
                type="Kingletas\ProcessGuard\Model\Policy\ObserverPolicyResolver"/>
    <preference for="Kingletas\ProcessGuard\Api\ProcessJournalInterface"
                type="Kingletas\ProcessGuard\Model\Journal\RequestJournal"/>
    <preference for="Kingletas\ProcessGuard\Api\ProcessReporterInterface"
                type="Kingletas\ProcessGuard\Model\Report\LogReporter"/>
    <preference for="Kingletas\ProcessGuard\Api\ClockInterface"
                type="Kingletas\ProcessGuard\Model\Guard\Clock"/>

    <!--
        The config section id is an argument, not a constant, which is what
        makes the module rebrandable: bin/rebrand rewrites this one string.
    -->
    <type name="Kingletas\ProcessGuard\Model\Config">
        <arguments>
            <argument name="section" xsi:type="string">kingletas_processguard</argument>
        </arguments>
    </type>

    <!-- Its own log channel: a guard that writes into system.log is a guard nobody reads. -->
    <virtualType name="Kingletas\ProcessGuard\Logger\Handler" type="Kingletas\Logger\Handler">
        <arguments>
            <argument name="fileName" xsi:type="string">process_guard.log</argument>
            <argument name="subDirectory" xsi:type="string">kingletas</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\ProcessGuard\Logger" type="Kingletas\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">kingletas_process_guard</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Kingletas\ProcessGuard\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Kingletas\ProcessGuard\Model\Report\LogReporter">
        <arguments>
            <argument name="logger" xsi:type="object">Kingletas\ProcessGuard\Logger</argument>
        </arguments>
    </type>

    <!-- Budgets. -->
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\OrderPlacementBudget"
                 type="Kingletas\ProcessGuard\Model\Guard\Budget">
        <arguments>
            <argument name="warnMilliseconds" xsi:type="number">1000</argument>
            <argument name="tripMilliseconds" xsi:type="number">4000</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\CatalogEventBudget"
                 type="Kingletas\ProcessGuard\Model\Guard\Budget">
        <arguments>
            <argument name="warnMilliseconds" xsi:type="number">750</argument>
            <argument name="tripMilliseconds" xsi:type="number">3000</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\TotalsBudget"
                 type="Kingletas\ProcessGuard\Model\Guard\Budget">
        <arguments>
            <argument name="warnMilliseconds" xsi:type="number">1500</argument>
            <!--
                No trip: a totals collection cannot be skipped, because the
                answer would be wrong prices.
            -->
            <argument name="maxCalls" xsi:type="number">4</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\ProductSaveBudget"
                 type="Kingletas\ProcessGuard\Model\Guard\Budget">
        <arguments>
            <argument name="warnMilliseconds" xsi:type="number">2000</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\ConsumerBudget"
                 type="Kingletas\ProcessGuard\Model\Guard\Budget">
        <arguments>
            <argument name="warnMilliseconds" xsi:type="number">120000</argument>
            <!-- 768MB. -->
            <argument name="memoryBytes" xsi:type="number">805306368</argument>
        </arguments>
    </virtualType>

    <!-- One directory of budgets, so the guard and the report can never disagree. -->
    <virtualType name="Kingletas\ProcessGuard\Model\Guard\Budgets"
                 type="Kingletas\ProcessGuard\Model\Guard\BudgetDirectory">
        <arguments>
            <argument name="budgets" xsi:type="array">
                <item name="event.sales_model_service_quote_submit_before" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\OrderPlacementBudget</item>
                <item name="event.sales_model_service_quote_submit_success" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\OrderPlacementBudget</item>
                <item name="event.sales_order_place_after" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\OrderPlacementBudget</item>
                <item name="event.checkout_submit_all_after" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\OrderPlacementBudget</item>
                <item name="event.catalog_product_save_before" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\CatalogEventBudget</item>
                <item name="event.catalog_product_save_after" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\CatalogEventBudget</item>
                <item name="quote.collect_totals" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\TotalsBudget</item>
                <item name="catalog.product_save" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\ProductSaveBudget</item>
                <item name="queue.consumer" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\ConsumerBudget</item>
            </argument>
        </arguments>
    </virtualType>

    <!--
        The shipped budgets are their own argument, so `budgets` stays an array:
        a store's own di.xml adds or replaces a budget there by name, and wiring
        cached by an earlier release still fits it.
    -->
    <type name="Kingletas\ProcessGuard\Model\Guard\ProcessGuard">
        <arguments>
            <argument name="budgetDirectory" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\Budgets</argument>
        </arguments>
    </type>

    <!--
        Which events are watched, and what is declared about the observers on
        them.
    -->
    <type name="Kingletas\ProcessGuard\Model\Policy\ObserverPolicyResolver">
        <arguments>
            <argument name="guardedEvents" xsi:type="array">
                <item name="quote_submit_before" xsi:type="string">sales_model_service_quote_submit_before</item>
                <item name="quote_submit_success" xsi:type="string">sales_model_service_quote_submit_success</item>
                <item name="order_place_after" xsi:type="string">sales_order_place_after</item>
                <item name="checkout_submit_all_after" xsi:type="string">checkout_submit_all_after</item>
                <item name="checkout_cart_product_add_after" xsi:type="string">checkout_cart_product_add_after</item>
                <item name="sales_quote_collect_totals_before" xsi:type="string">sales_quote_collect_totals_before</item>
                <item name="sales_quote_collect_totals_after" xsi:type="string">sales_quote_collect_totals_after</item>
                <item name="catalog_product_save_before" xsi:type="string">catalog_product_save_before</item>
                <item name="catalog_product_save_after" xsi:type="string">catalog_product_save_after</item>
            </argument>
            <argument name="classifications" xsi:type="array"/>
        </arguments>
    </type>

    <!-- The detail bound. Counts are unaffected; see ProcessJournalInterface. -->
    <type name="Kingletas\ProcessGuard\Model\Journal\RequestJournal">
        <arguments>
            <argument name="detailLimit" xsi:type="number">500</argument>
        </arguments>
    </type>

    <!-- The gate. -->
    <type name="Magento\Framework\Event\Invoker\InvokerDefault">
        <plugin name="kingletas_process_guard_observer_gate"
                type="Kingletas\ProcessGuard\Plugin\Event\GuardedInvoker"
                sortOrder="10"/>
    </type>
    <type name="Magento\Quote\Model\Quote\TotalsCollector">
        <plugin name="kingletas_process_guard_totals"
                type="Kingletas\ProcessGuard\Plugin\Quote\GuardedTotalsCollector"
                sortOrder="10"/>
    </type>
    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="kingletas_process_guard_product_save"
                type="Kingletas\ProcessGuard\Plugin\Catalog\GuardedProductSave"
                sortOrder="10"/>
    </type>
    <!--
        On the interface, because a monitor covering only some consumers means
        nothing when silent.
    -->
    <type name="Magento\Framework\MessageQueue\ConsumerInterface">
        <plugin name="kingletas_process_guard_consumer"
                type="Kingletas\ProcessGuard\Plugin\MessageQueue\GuardedConsumer"
                sortOrder="10"/>
    </type>

    <!--
        Where one unit of work ends. A consumer's own budget covers the whole
        consumer; everything inside it is judged one message at a time.
    -->
    <preference for="Kingletas\ProcessGuard\Api\UnitOfWorkInterface"
                type="Kingletas\ProcessGuard\Model\Guard\ProcessGuard"/>

    <type name="Magento\Framework\MessageQueue\CallbackInvokerInterface">
        <plugin name="kingletas_process_guard_message_unit"
                type="Kingletas\ProcessGuard\Plugin\MessageQueue\PerMessageUnit"
                sortOrder="5"/>
    </type>

    <type name="Magento\Framework\MessageQueue\QueueInterface">
        <plugin name="kingletas_process_guard_subscribe_unit"
                type="Kingletas\ProcessGuard\Plugin\MessageQueue\PerMessageUnit"
                sortOrder="5"/>
    </type>

    <type name="Magento\Cron\Model\Schedule">
        <plugin name="kingletas_process_guard_cron_unit"
                type="Kingletas\ProcessGuard\Plugin\Cron\PerJobUnit"
                sortOrder="5"/>
    </type>

    <!--
        The breakdown of a collection. Off by default: this is one plugin call
        per collector per collection, and it answers a question nobody has
        until a collection is slow.
    -->
    <type name="Magento\Quote\Model\Quote\Address\Total\CollectorInterface">
        <plugin name="kingletas_process_guard_total_collector"
                type="Kingletas\ProcessGuard\Plugin\Quote\GuardedTotalCollector"
                sortOrder="10"/>
    </type>

    <!-- Frames that are never the answer to "who asked for this". -->
    <type name="Kingletas\ProcessGuard\Model\Guard\CallerResolver">
        <arguments>
            <argument name="ignoredPrefixes" xsi:type="array">
                <item name="guard" xsi:type="string">Kingletas\ProcessGuard</item>
                <item name="interception" xsi:type="string">Magento\Framework\Interception</item>
                <item name="totals" xsi:type="string">Magento\Quote\Model\Quote\TotalsCollector</item>
                <!-- Always the immediate caller, so it answers nothing. -->
                <item name="quote" xsi:type="string">Magento\Quote\Model\Quote::collectTotals</item>
            </argument>
        </arguments>
    </type>

    <!-- The command name is wiring, so `bin/rebrand` rewrites it with the rest. -->
    <!-- Every bin/magento run builds every command, so the guard is built only when the report runs. -->
    <type name="Kingletas\ProcessGuard\Console\Command\ShowPoliciesCommand">
        <arguments>
            <argument name="name" xsi:type="string">kingletas:process-guard:policies</argument>
            <argument name="guard" xsi:type="object">Kingletas\ProcessGuard\Model\Guard\ProcessGuard\Proxy</argument>
        </arguments>
    </type>

    <type name="Kingletas\ProcessGuard\Console\Command\CheckConfigurationCommand">
        <arguments>
            <argument name="name" xsi:type="string">kingletas:process-guard:check</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="kingletas_process_guard_policies" xsi:type="object">Kingletas\ProcessGuard\Console\Command\ShowPoliciesCommand</item>
                <item name="kingletas_process_guard_check" xsi:type="object">Kingletas\ProcessGuard\Console\Command\CheckConfigurationCommand</item>
            </argument>
        </arguments>
    </type>

</config>
